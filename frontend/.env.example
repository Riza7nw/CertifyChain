# Base URL backend API.
# Saat development, biarkan kosong/relatif "/api" agar memakai proxy Vite (lihat vite.config.js).
# Saat production (frontend & backend beda domain), isi penuh, mis:
# VITE_API_BASE_URL=https://api.certifychain.example.com/api
VITE_API_BASE_URL=/api

# Target backend untuk proxy dev (dipakai vite.config.js). Default http://localhost:3000
VITE_API_TARGET=http://localhost:3000
