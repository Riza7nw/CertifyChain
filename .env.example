# ==========================================================
#  ROOT .env — dipakai Hardhat untuk deploy kontrak
#  (hardhat.config.js membaca PRIVATE_KEY & RPC dari sini)
#  Salin jadi `.env` lalu isi. JANGAN commit file .env asli!
# ==========================================================

# Jaringan AKTIF: Arbitrum Sepolia (chainId 421614), dipakai `--network arbitrumSepolia`.
# Opsional — bila kosong dipakai RPC publik https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_SEPOLIA_RPC_URL=

# Jaringan lama: Ethereum Sepolia (chainId 11155111), dipakai `--network sepolia`.
# Hanya perlu diisi bila ingin deploy ke Sepolia.
RPC_URL=

# Private key wallet deployer (pakai wallet TESTNET, boleh dengan/tanpa prefix 0x)
PRIVATE_KEY=your_wallet_private_key
