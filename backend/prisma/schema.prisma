// Prisma schema — read-model CertifyChain (PostgreSQL).
// Field sengaja snake_case agar bentuk objek hasil query identik dengan
// repository node:sqlite -> controller tidak perlu berubah saat DB_DRIVER=postgres.
// Langkah 1 = SWAP DB faithful (struktur sama). Tabel multi-tenant (users/orgs)
// menyusul di Langkah 2.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model meta {
  key   String  @id
  value String?

  @@map("meta")
}

model institutions {
  id            Int      @id // = institutionId on-chain (di-set eksplisit, bukan auto)
  name          String
  metadata_cid  String?
  admin_address String?
  active        Boolean  @default(true)
  tx_hash       String?
  block_number  Int?
  created_at    DateTime @default(now())

  @@map("institutions")
}

model certificates {
  certificate_id  String   @id
  institution_id  Int
  recipient_name  String? // PII off-chain
  recipient_email String? // Phase 7: pengikat ke akun User (penerima). Off-chain.
  file_cid        String?
  data_hash       String?
  issued_by       String?
  status          String   @default("valid") // valid | revoked | pending
  tx_hash         String?
  block_number    Int?
  issued_at       String? // ISO string (parity dengan sqlite; substr utk grouping harian)
  created_at      DateTime @default(now())

  // PDF certificate (Fase A): artefak generate vs upload
  template_key    String? // key template di registry kode (mis. 'classic'); null = uploaded
  artifact_type   String   @default("uploaded") // 'uploaded' | 'generated'
  pdf_hash        String? // keccak256 byte PDF (kemudahan; fileCid tetap jangkar utama)
  signed          Boolean  @default(false) // PAdES diterapkan? (fase lanjutan)
  render_status   String   @default("done") // queued | rendering | done | failed

  @@index([institution_id])
  @@index([issued_at])
  @@index([recipient_email])
  @@map("certificates")
}

model verifications {
  id             Int      @id @default(autoincrement())
  certificate_id String?
  institution_id Int?
  valid          Int? // 0/1 (parity dgn sqlite; memudahkan SUM utk statistik)
  ip             String?
  day            String // YYYY-MM-DD
  created_at     DateTime @default(now())

  @@index([day])
  @@index([institution_id])
  @@map("verifications")
}

// ======================= IDENTITY / MULTI-TENANT (Langkah 2) =======================
// Tabel ini Postgres-only (identity store SaaS). Terpisah dari read-model di atas.

model organizations {
  id                     Int           @id @default(autoincrement())
  name                   String
  slug                   String        @unique
  onchain_institution_id Int?          @unique // link ke institutions.id (read-model); null sampai diprovision on-chain
  created_at             DateTime      @default(now())
  memberships            memberships[]

  @@map("organizations")
}

model users {
  id                Int              @id @default(autoincrement())
  email             String           @unique
  password_hash     String
  name              String?
  role              String           @default("user") // Phase 7: 'admin' | 'user' (role global, sumber kebenaran)
  is_platform_admin Boolean          @default(false) // DEPRECATED — dipertahankan utk transisi; pakai `role`
  email_verified_at DateTime? // null = belum verifikasi email
  active            Boolean          @default(true) // admin bisa nonaktifkan user
  created_at        DateTime         @default(now())
  memberships       memberships[]
  refresh_tokens    refresh_tokens[]
  email_tokens      email_tokens[]

  @@map("users")
}

// Token verifikasi email & reset password (disimpan sbg sha256).
model email_tokens {
  id         Int      @id @default(autoincrement())
  user_id    Int
  type       String // 'verify' | 'reset'
  token_hash String   @unique
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())
  user       users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("email_tokens")
}

// Audit unduhan sertifikat oleh penerima (opsional).
model certificate_downloads {
  id             Int      @id @default(autoincrement())
  certificate_id String
  user_id        Int
  ip             String?
  created_at     DateTime @default(now())

  @@index([certificate_id])
  @@map("certificate_downloads")
}

model memberships {
  id              Int           @id @default(autoincrement())
  user_id         Int
  organization_id Int
  role            String // OrgAdmin | Issuer | Viewer
  created_at      DateTime      @default(now())
  user            users         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  organization    organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([user_id, organization_id])
  @@map("memberships")
}

model refresh_tokens {
  id         Int      @id @default(autoincrement())
  user_id    Int
  token_hash String   @unique // sha256(raw token) — raw tidak pernah disimpan
  expires_at DateTime
  revoked    Boolean  @default(false)
  created_at DateTime @default(now())
  user       users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("refresh_tokens")
}
