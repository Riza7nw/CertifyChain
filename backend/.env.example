# ==========================================================
#  KONFIGURASI CERTIFYCHAIN BACKEND
#  Salin file ini menjadi `.env` lalu isi nilainya.
#  JANGAN commit file .env asli ke repository!
# ==========================================================

# Port server Express
PORT=3000

# RPC URL node blockchain. Jaringan aktif: Arbitrum Sepolia (L2, konfirmasi <1 detik).
# RPC publik (tanpa API key): https://sepolia-rollup.arbitrum.io/rpc
# Alchemy:                   https://arb-sepolia.g.alchemy.com/v2/XXXXXXXX
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Private key wallet penerbit (HARUS owner kontrak). Pakai wallet testnet!
# Diawali 0x...
PRIVATE_KEY=0xyour_private_key_here

# Alamat kontrak CertifyChain yang sudah ter-deploy
CONTRACT_ADDRESS=0xyour_deployed_contract_address

# Chain ID jaringan: 421614 = Arbitrum Sepolia, 11155111 = Ethereum Sepolia.
# Isi selalu — posisi indexer disimpan per chain ID + alamat kontrak.
CHAIN_ID=421614

# (Opsional) Seberapa sering backend mengecek konfirmasi transaksi (ms). Default 500.
RPC_POLLING_INTERVAL_MS=500

# URL publik frontend, dipakai untuk membentuk link verifikasi di dalam QR Code.
# Contoh produksi: https://certifychain.example.com
PUBLIC_BASE_URL=http://localhost:5173

# ==========================================================
#  SECURITY LAYER (JWT Auth untuk admin)
# ==========================================================

# Rahasia penandatangan JWT. WAJIB acak & panjang (>=32 char).
# Generate, mis: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti_dengan_string_acak_panjang_min_32_karakter

# Masa berlaku token (mis. 15m, 1h, 12h)
JWT_EXPIRES_IN=1h

# Kredensial admin. Password DISIMPAN sebagai bcrypt hash, bukan plaintext.
# Buat hash: npm run hash-password -- "passwordRahasiaAnda"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2a$10$ganti_dengan_hasil_bcrypt_hash

# --- Multi-tenant auth (Langkah 2) ---
# Masa berlaku access token & refresh token
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Email untuk akun PlatformAdmin yang dibuat `npm run seed` (password = ADMIN_PASSWORD_HASH)
SEED_ADMIN_EMAIL=admin@certifychain.local

# --- Email verification (Phase 7b) ---
# Provider email: console (dev, cetak link ke log) | resend (produksi, kirim asli)
MAIL_PROVIDER=console
# Pengirim. Untuk MAIL_PROVIDER=resend WAJIB domain yang sudah diverifikasi di Resend
# (mis. "CertifyChain <noreply@domainanda.com>"); untuk uji boleh "onboarding@resend.dev".
MAIL_FROM=CertifyChain <no-reply@certifychain.local>
EMAIL_VERIFY_TTL_HOURS=24
# API key Resend (https://resend.com) — wajib bila MAIL_PROVIDER=resend.
RESEND_API_KEY=
# CORS allowlist (origin frontend, pisah koma). Wajib spesifik karena cookie pakai credentials.
CORS_ORIGINS=http://localhost:5173

# ==========================================================
#  SCALING: Database (read-model) & IPFS storage
# ==========================================================

# Driver read-model: sqlite (node:sqlite, default) | postgres (Prisma)
DB_DRIVER=sqlite
# Path file DB saat DB_DRIVER=sqlite
DB_PATH=./data/certifychain.db
# Koneksi Postgres saat DB_DRIVER=postgres (lihat docker-compose.yml untuk dev)
DATABASE_URL=postgresql://certifychain:certifychain_dev@localhost:5433/certifychain?schema=public

# Interval polling indexer (ms)
INDEXER_POLL_MS=5000
# Maks rentang blok per request eth_getLogs (default 1000 = hemat API call).
# PERINGATAN: Alchemy/Infura FREE tier hanya mengizinkan 10 blok -> set ke 10 di free tier,
# selain itu eth_getLogs ditolak (error -32600). Nilai besar butuh RPC PAYG/self-host.
# Arbitrum Sepolia membuat hingga ~4 blok/detik: rentang 10 blok TIDAK akan pernah
# mengejar. Pakai RPC yang mengizinkan rentang besar (mis. RPC publik) + nilai >= 2000.
INDEXER_MAX_BLOCK_RANGE=2000
# Blok awal backfill = blok deployment kontrak (lihat output deployV3 / explorer).
# WAJIB diisi agar indexer tidak men-scan dari blok 0 (sangat lambat).
INDEXER_START_BLOCK=0
# Batas chunk per siklus polling (free tier: kecil agar tidak kena 429)
INDEXER_MAX_CHUNKS_PER_CYCLE=5
# Jeda (ms) setelah SETIAP request getLogs -> hindari error 429 (rate limit)
INDEXER_REQUEST_DELAY_MS=1000

# Penyimpanan file sertifikat: local | ipfs | pinata
STORAGE_PROVIDER=local
# Jika STORAGE_PROVIDER=ipfs (Kubo daemon):
IPFS_API_URL=http://127.0.0.1:5001
# Jika STORAGE_PROVIDER=pinata:
PINATA_JWT=
# Basis URL gateway untuk mengakses file (kosongkan untuk default).
# local -> /api/files ; ipfs/pinata -> https://ipfs.io/ipfs
IPFS_GATEWAY_BASE=

# --- Render PDF async / antrian (Fase C-scale, butuh DB_DRIVER=postgres) ---
# true  -> endpoint generate meng-enqueue job (balas 202) & worker memproses di latar.
#          Jalankan worker: npm run worker
# false -> jalur sinkron (default; tak butuh worker).
PDF_ASYNC_ENABLED=false
# Interval polling worker saat antrian kosong (ms)
RENDER_WORKER_POLL_MS=2000
# Job 'processing' yang macet lebih lama dari ini di-requeue (ms)
RENDER_WORKER_STUCK_MS=120000
# Maks percobaan per job sebelum 'failed'
RENDER_JOB_MAX_ATTEMPTS=3
# Jeda backoff sebelum retry job yang gagal (ms)
RENDER_JOB_BACKOFF_MS=15000
